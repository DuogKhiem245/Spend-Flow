<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_remaining_balance"
                android:textColor="#9E9EA7"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_total_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ₫"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#2E2E38" />

    <!-- Empty view -->
    <TextView
        android:id="@+id/tv_empty_tx"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty_tx"
        android:textColor="#7A7A85"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Transactions List Container -->
    <LinearLayout
        android:id="@+id/tx_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- TX 1 -->
        <LinearLayout
            android:id="@+id/row_tx_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_tx1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_default_transaction"
                    android:textColor="#F3F3F6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tx1_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_default_category"
                    android:textColor="#8E8E9A"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_tx1_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-0 ₫"
                android:textColor="#FF453A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TX 2 -->
        <LinearLayout
            android:id="@+id/row_tx_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_tx2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_default_transaction"
                    android:textColor="#F3F3F6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tx2_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_default_category"
                    android:textColor="#8E8E9A"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_tx2_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-0 ₫"
                android:textColor="#FF453A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TX 3 -->
        <LinearLayout
            android:id="@+id/row_tx_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_tx3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_default_transaction"
                    android:textColor="#F3F3F6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tx3_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_default_category"
                    android:textColor="#8E8E9A"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_tx3_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-0 ₫"
                android:textColor="#32D74B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
